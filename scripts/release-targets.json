{
  "schemaVersion": 1,
  "targets": [
    {
      "id": "english",
      "name": "English Automaticity",
      "projectDir": "Apps/English/English-Automaticity",
      "deployment": {
        "provider": "vercel",
        "projectName": "english-grammar-automaticity-pwa",
        "rootDirectory": "Apps/English/English-Automaticity",
        "configFile": "Apps/English/English-Automaticity/vercel.json"
      },
      "build": { "command": "bun", "args": ["run", "build"] },
      "localChecks": [
        { "url": "http://127.0.0.1:3202/", "kind": "html", "includes": ["dir=\"ltr\""] },
        { "url": "http://127.0.0.1:4201/api/health", "kind": "json", "expected": { "service": "grammar-automaticity-api", "status": "ok" } }
      ],
      "publicAccess": "public",
      "publicChecks": [
        { "url": "https://english-grammar-automaticity-pwa.vercel.app/", "kind": "html", "includes": ["English Automaticity"] }
      ]
    },
    {
      "id": "german",
      "name": "Deutsch Automaticity",
      "projectDir": "Apps/Deutsch-Automaticity",
      "deployment": {
        "provider": "vercel",
        "projectName": "deutschflow-grammar",
        "rootDirectory": "Apps/Deutsch-Automaticity",
        "configFile": "Apps/Deutsch-Automaticity/vercel.json"
      },
      "build": { "command": "bun", "args": ["run", "build"] },
      "localChecks": [
        { "url": "http://127.0.0.1:3210/", "kind": "html", "includes": ["dir=\"ltr\""] },
        { "url": "http://127.0.0.1:4210/api/v1/health", "kind": "json", "expected": { "service": "grammar-api", "status": "ok" } }
      ],
      "publicAccess": "public",
      "publicChecks": [
        { "url": "https://deutschflow-grammar.vercel.app/", "kind": "html", "includes": ["DeutschFlow"] }
      ]
    },
    {
      "id": "tracker",
      "name": "Cross Repository Tracker",
      "projectDir": "Apps/Cross_Repository_Code_Intelligence-Version",
      "deployment": {
        "provider": "vercel",
        "projectName": "study-tracker-plan",
        "rootDirectory": "Apps/Cross_Repository_Code_Intelligence-Version",
        "configFile": "Apps/Cross_Repository_Code_Intelligence-Version/vercel.json"
      },
      "build": { "command": "bun", "args": ["run", "build"] },
      "localChecks": [
        { "url": "http://127.0.0.1:4312/", "kind": "html", "includes": ["dir=\"ltr\""] },
        { "url": "http://127.0.0.1:4313/v1/health", "kind": "json", "expected": { "ok": true, "service": "cross-repository-api" } }
      ],
      "publicAccess": "public",
      "publicChecks": [
        { "url": "https://study-tracker-plan-five.vercel.app/", "kind": "html", "includes": ["Cross-Repository"] }
      ]
    },
    {
      "id": "settings",
      "name": "Settings",
      "projectDir": "Apps/Apps-For-Integeration/Einstellungen-APP",
      "deployment": { "provider": "local", "reason": "Starter-managed local application" },
      "build": { "command": "bun", "args": ["run", "build"] },
      "localChecks": [
        { "url": "http://127.0.0.1:4323/settings", "kind": "html", "includes": ["dir=\"ltr\""] }
      ],
      "publicAccess": "local-only",
      "publicChecks": []
    },
    {
      "id": "pdf",
      "name": "Research PDF Studio",
      "projectDir": "Apps/Apps-For-Integeration/Reader-PDF-App",
      "deployment": {
        "provider": "vercel",
        "projectName": "research-pdf-studio",
        "rootDirectory": "Apps/Apps-For-Integeration/Reader-PDF-App",
        "configFile": "Apps/Apps-For-Integeration/Reader-PDF-App/vercel.json"
      },
      "build": { "command": "bun", "args": ["run", "build"] },
      "localChecks": [
        { "url": "http://127.0.0.1:4332/", "kind": "html", "includes": ["dir=\"ltr\""] },
        { "url": "http://127.0.0.1:4332/api/health", "kind": "json", "expected": { "service": "research-pdf-studio", "ready": true, "contractVersion": 1 } }
      ],
      "publicAccess": "public",
      "publicChecks": [
        { "url": "https://research-pdf-studio.vercel.app/", "kind": "html", "includes": ["Research PDF Studio"] }
      ]
    }
  ]
}
